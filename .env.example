# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/onsite_dumpsters?schema=public"

# ── Auth.js ───────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Google OAuth (optional; enables "Sign in with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (TEST keys for end-to-end demo; LIVE keys for production) ──
# Get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret from `stripe listen` or Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=""
# Optional: restrict Connect onboarding return URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── App ───────────────────────────────────────────────────
NODE_ENV="development"
